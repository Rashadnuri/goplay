{
  "name": "goplay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GO PLAY \u2014 Play. Think. Compete.",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run src/engine",
    "test:db": "vitest run tests/db",
    "test:ai": "vitest run ai-service",
    "test:ui": "node tests/ui/responsive.mjs",
    "sync:engine": "node scripts/sync-engine.mjs",
    "gen:seed": "node scripts/gen-seed.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test:online": "tsx tests/ui/online-mock.ts",
    "test:all": "npm run typecheck && vitest run && npm run build && node tests/ui/responsive.mjs && tsx tests/ui/online-mock.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.14.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
